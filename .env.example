# Copy to .env.local and fill in. Values below are placeholders.
# For local development, `npx supabase status -o env` prints the local values.

# Public (shipped to the browser) — URL + publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER prefix with NEXT_PUBLIC_. Used for invite acceptance,
# account deactivation (auth ban) and admin password-reset emails.
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key

# Server only. Bearer secret for scheduled jobs (Vercel Cron sends it automatically).
CRON_SECRET=replace-with-a-long-random-string
